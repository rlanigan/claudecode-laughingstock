# Database
DATABASE_URL=postgres://cards:cards@localhost:5432/cards
DATABASE_URL_UNPOOLED=postgres://cards:cards@localhost:5432/cards

# Auth
AUTH_SECRET=
AUTH_URL=http://localhost:3000
ALLOWED_EMAILS=
RESEND_API_KEY=
EMAIL_FROM="Cards <signin@example.com>"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SHOW_SCREEN_IDS=true
CRON_SECRET=
LOG_LEVEL=debug

# AI assist (optional)
AI_FEATURES_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Voice notes (optional, later phase)
TRANSCRIPTION_ENABLED=false
TRANSCRIPTION_API_KEY=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Error reporting (optional locally)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Development seed
SEED_USER_EMAIL=demo@example.com
